# backend/.env — 값을 채워 .env 로 복사해 사용합니다.
# docker-compose 의 backend 서비스가 env_file 로 읽습니다.

# ── DB (MariaDB) ─────────────────────────────────────────
# 괄호 안은 코드의 기본값 — 같은 값이면 생략해도 됩니다.
DB_HOST=mariadb          # (mariadb)
DB_PORT=3306             # (3306)
DB_USER=maplestory       # (maplestory)
DB_PASSWORD=             # (없음) 반드시 지정
DB_NAME=maplestory       # (maplestory)

# ── S3 호환 스토리지 (RustFS·MinIO·AWS S3) ───────────────
# 보스·심볼·아이콘 이미지 저장용. 관리자 업로드에 필요합니다.
S3_ENDPOINT=             # 예: https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=           # 브라우저가 이미지를 받는 공개 주소 (버킷 앞까지)

# ── NEXON Open API ───────────────────────────────────────
# https://openapi.nexon.com 에서 발급. 캐릭터·심볼·헥사·강화 이력·공지 조회에 사용합니다.
# 로그인은 사용자가 각자 입력한 키로 처리하며 서버에 저장하지 않습니다.
NEXON_API_KEY=

# ── 서버 ─────────────────────────────────────────────────
PORT=3000                # (3000)
NODE_ENV=production

# 작업용 문서 (커밋 제외) — 단, README가 참조하는 구조도는 포함한다
docs/*
!docs/images/
docs/images/*
!docs/images/architecture.html
!docs/images/architecture.png

# 작업용 시안 (커밋 제외)
mockups/

# 분석용 화면 캡처 — 결론은 코드·주석에 남기고 파일은 커밋하지 않는다.
# 사이트 구동에는 쓰이지 않고(코드는 S3의 /api/images만 본다) 용량만 27MB였다.
# 보스·난이도 아이콘은 S3에 올릴 원본이라 남긴다.
images/*.mp4
images/*.png
images/resolution-reference/
# 타이머 템플릿은 frontend/src/features/timer/{rune,booster}/ 가 원본 — 여기 사본은 중복
images/rune-templates/
images/booster-templates/
